import "../../neurosynaptic_perifery/primitives.act";
import globals;

open tmpl::neurosynaptic_perifery;


defproc merge_2 (awMx1of2<2> in1; awMx1of2<2> in2; awMx1of2<2> out){

    merge<2> merge_cell(.in1=in1, .in2=in2,.out = out);
    //Low active Reset 
    bool _reset_B; 
    prs {
    	Reset => _reset_B-
    }
    merge_cell.supply.vss = GND;
    merge_cell.supply.vdd = Vdd;
    merge_cell.reset_B = _reset_B;
    
}

merge_2 my_merge;
