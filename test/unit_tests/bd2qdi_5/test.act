import "../../neurosynaptic_perifery/interfaces.act";
import globals;

open tmpl::neurosynaptic_perifery;

defproc bd2qdi_5(bd<5> in; awMx1of2<5> out; bool? dly_cfg[4]; bool? dly_cfg2[2])
{
  bool _reset_B; 
  prs {
    Reset => _reset_B-
  }
  bd2qdi<5,4,2> b(.in = in, .out = out, .reset_B = _reset_B, .dly_cfg = dly_cfg, .dly_cfg2 = dly_cfg2);
  b.supply.vdd = Vdd;
  b.supply.vss = GND; 
}

bd2qdi_5 b;