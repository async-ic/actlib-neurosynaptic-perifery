import "../../neurosynaptic_perifery/coders.act";
import "../../neurosynaptic_perifery/primitives.act";
import "../../neurosynaptic_perifery/cell_lib_async.act";
import "../../neurosynaptic_perifery/cell_lib_std.act";


import globals;
import std::data;

open std::data;

open tmpl::neurosynaptic_perifery;

defproc demux_qdi2bd_1d_test (awMx1of2<4> in; rbd<4> out[15]){

    demux_qdi2bd_1d<15, 4> decoder_test(.in=in, .out=out);
    //Low active Reset 
    bool _reset_B; 
    prs {
    	Reset => _reset_B-
    }
    decoder_test.supply.vss = GND;
    decoder_test.supply.vdd = Vdd;
    decoder_test.reset_B = _reset_B;
    
}

demux_qdi2bd_1d_test t;
