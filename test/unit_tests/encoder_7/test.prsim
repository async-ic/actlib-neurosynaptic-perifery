watchall

system "echo '0'"

set e.in[0] 0
set e.in[1] 0
set e.in[2] 0
set e.in[3] 0
set e.in[4] 0
set e.in[5] 0
set e.in[6] 0

# set-bool-array "e.in" 7 0

cycle
mode run

# assert t.out 0

system "echo '[] setting input 0 high'"
set Reset 0
set e.in[0] 1
cycle

system "echo '[] removing inputs'"
set e.in[0] 0
cycle

system "echo '[] setting input 4 high'"
set e.in[4] 1
cycle

system "echo '[] removing inputs'"
set e.in[4] 0
cycle

system "echo '[] setting input 6 high'"
set e.in[6] 1
cycle

system "echo '[] removing inputs'"
set e.in[6] 0
cycle



