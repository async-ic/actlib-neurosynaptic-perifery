import "../../neurosynaptic_perifery/treegates.act";
import globals;

open tmpl::neurosynaptic_perifery;

defproc ortree_15 (bool? in[15]; bool! out){
    ortree<15> ortree_test(.in=in, .out=out);
    ortree_test.supply.vss = GND;
    ortree_test.supply.vdd = Vdd;

}

ortree_15 t; 