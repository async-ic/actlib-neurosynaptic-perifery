import "../../neurosynaptic_perifery/primitives.act";

import globals;
import std::data;

open std::data;

open tmpl::neurosynaptic_perifery;

defproc dropper_static_7 (awMx1of2<7> in; awMx1of2<7> out; bool? drop){
    bool _reset_B; 
    prs {
        Reset => _reset_B-
    }
    power supply;
    supply.vdd = Vdd;
    supply.vss = GND;

    dropper_static<7, true> b(.in = in, .out = out, .cond = drop, .supply = supply);
}


// fifo_decoder_neurons_encoder_fifo e;
dropper_static_7 b;