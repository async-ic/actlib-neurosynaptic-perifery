import "../../neurosynaptic_perifery/coders.act";
import globals;

open tmpl::neurosynaptic_perifery;

defproc nrn_hs_2d_inst(a1of1 in; a1of1 outx, outy)
{
	power supply;
    supply.vdd = Vdd;
    supply.vss = GND;

	bool _reset_B; 
	prs {
		Reset => _reset_B-
	}
	nrn_hs_2d b(.in = in, .outx = outx, .outy = outy,
		.supply = supply, .reset_B = _reset_B);

	nrn_line_end_pull_down pd_x;
	pd_x.in = b.outx.a;
	pd_x.out = b.outx.r;
	pd_x.supply = supply;
	pd_x.reset_B = _reset_B;

	nrn_line_end_pull_down pd_y;
	pd_y.in = b.outy.a;
	pd_y.out = b.outy.r;
	pd_y.supply = supply;
	pd_y.reset_B = _reset_B;
	


	

}

nrn_hs_2d_inst b;
