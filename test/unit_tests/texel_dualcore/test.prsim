# SPIKES

system "echo '[] Sending spike to core 0 synapse [0,0]'"
set-bd-data-valid "c.in" 32 0
cycle
set c.in.r 1
cycle
assert c.in.a 1

assert c.c1_synapses[0].r 1
set c.c1_synapses[0].a 1
cycle
assert c.c1_synapses[0].r 0
set c.c1_synapses[0].a 0
cycle
system "echo '[] Removing input'"
set-bd-channel-neutral "c.in" 32
