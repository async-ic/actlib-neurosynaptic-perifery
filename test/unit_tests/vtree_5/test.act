import "../../neurosynaptic_perifery/cell_lib_async.act";
import "../../neurosynaptic_perifery/cell_lib_std.act";
import "../../neurosynaptic_perifery/treegates.act";
import "../../neurosynaptic_perifery/primitives.act";
import "../../neurosynaptic_perifery/coders.act";
import globals;
import std::channel;
open std::channel;
open tmpl::neurosynaptic_perifery;

defproc vtree_5 (awMx1of2?<5> in; bool! out){

    Mx1of2?<5> _in;
    (i:5:_in.d[i] = in.d.d[i];)
    vtree<5> vtree_test(.in=_in, .out=out);
    vtree_test.supply.vss = GND;
    vtree_test.supply.vdd = Vdd;

}

vtree_5 t;
