watchall

set-qdi-channel-neutral "t.in" 3
set Reset 0

# Set delay config lines
set t.dly_cfg[0] 1
set t.dly_cfg[1] 1
set t.dly_cfg[2] 1
set t.dly_cfg[3] 1
cycle

system "echo '[] set Reset 1'"
set Reset 1
cycle

system "echo '[] set Reset 0'"
set Reset 0
mode run
cycle

system "echo '[] Sending packet in'"
set-qdi-channel-valid "t.in" 3 7
cycle
assert t.in.a 1
assert t.in.v 1


