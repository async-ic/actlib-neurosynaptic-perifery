import "../../neurosynaptic_perifery/coders.act";
import globals;

open tmpl::neurosynaptic_perifery;

defproc decoder_2d_dly_and_2_4(awMx1of2<1+2> in; bool? out[2*4], dly_cfg[4])

{
  bool _reset_B; 
  prs {
    Reset => _reset_B-
  }
  decoder_2d_dly<1,2,2,4,4> de(.in = in, .dly_cfg = dly_cfg);
  de.supply.vdd = Vdd;
  de.supply.vss = GND; 
  de.reset_B = _reset_B;

  and_grid<2,4> ag(.inx = de.outx, .iny = de.outy, .out = out);
  ag.supply.vdd = Vdd;
  ag.supply.vss = GND;

}

decoder_2d_dly_and_2_4 t;