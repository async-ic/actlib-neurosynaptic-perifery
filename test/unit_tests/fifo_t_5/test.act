import "../../neurosynaptic_perifery/primitives.act";
import globals;

open tmpl::neurosynaptic_perifery;

defproc fifo_t_5(a1of1 in; a1of1 out)

{
  fifo_t<5> a(.in = in, .out = out);
  a.supply.vdd = Vdd;
  a.supply.vss = GND; 
  a.reset_B = Reset;
}

fifo_t_5 t;