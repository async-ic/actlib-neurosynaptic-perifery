watchall

set-qdi-channel-neutral "b.in" 8
cycle


mode run
system "echo '[] Set reset 0'"
status X
set Reset 0
cycle
assert b.in.a 0
assert b.in.v 0

system "echo '[] Sending packet write 0s to reg0'"
set-qdi-channel-valid "b.in" 8 256
cycle
assert b.in.a 1
assert b.in.v 1
assert-var-int "b.data[0]" 5 0

system "echo '[] Removing input'"
set-qdi-channel-neutral "b.in" 8
cycle
assert b.in.a 0
assert b.in.v 0
assert-var-int "b.data[0]" 5 0

system "echo '[] Sending packet write 0s to reg0'"
set-qdi-channel-valid "b.in" 8 256
cycle
