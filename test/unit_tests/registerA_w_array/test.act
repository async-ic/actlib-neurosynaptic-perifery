import "../../neurosynaptic_perifery/registers.act";

import globals;
import std::data;

open std::data;

open tmpl::neurosynaptic_perifery;

defproc registerA_w_array_3x5x8 (awMx1of2<3+5> in; Mx1of2<5> data[8]){
    bool _reset_B; 
    prs {
        Reset => _reset_B-
    }
    power supply;
    supply.vdd = Vdd;
    supply.vss = GND;

    // Make a register array with 3 bit address (-> 8 registers), 
    // each register holding 5 bits.
    register_w_array<3,5,8> b(.in = in, .data = data, .reset_B = _reset_B, .supply = supply);
}


// fifo_decoder_neurons_encoder_fifo e;
registerA_w_array_3x5x8 b;