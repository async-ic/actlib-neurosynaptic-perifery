namespace tmpl {
    namespace neurosynaptic_perifery{
        export defcell KEEP (bool y; bool vdd, vss) {
            bool _y;
             prs{
                 // y => _y-
            //     [weak=1] _y -> y-
            //     [weak=1] ~_y -> y+

                 }
        }

        export defcell A_1C2N_RB_X1 (bool! y; bool? c1,n1,n2,pr_B, sr_B; bool vdd, vss) {
            bool _y;
            prs{
                (~c1)|~pr_B -> _y+
                c1 & n1 & n2 & sr_B -> _y-
                _y => y-
                }
            sizing {
                    leak_adjust <- 1; 
                    p_n_mode <- 1;
                    y {-1}; _y{-1} 
                    }
        }

        export defcell A_1C1P2N_RB_X1 (bool! y; bool? c1,p1,n1,n2,pr_B, sr_B; bool vdd, vss) {
            bool _y;
            prs{
                (~p1 & ~c1)|~pr_B -> _y+
                c1 & n1 & n2 & sr_B -> _y-
                _y => y-

                }
            sizing {
                    leak_adjust <- 1; 
                    p_n_mode <- 1;
                    y {-1}; _y{-1} 
                    }
        }


